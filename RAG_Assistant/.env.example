# Copy to `.env` (git-ignored) and fill in ONE provider. Real environment variables win over this file.

# ModelScope API-Inference (OpenAI-compatible). Run `python -m rag_assistant llm-models` to see the models your key can use.
MODELSCOPE_API_KEY=
# RAG_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Hybrid-reasoning models may need thinking disabled for grounded QA:
# RAG_LLM_EXTRA_JSON={"enable_thinking": false}

# Anthropic
ANTHROPIC_API_KEY=

# Any OpenAI-compatible server (OpenAI, vLLM, Ollama ...)
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1

# Force a provider instead of auto-detecting: anthropic | modelscope | openai
# RAG_LLM_PROVIDER=modelscope
